<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google belépés deep link (Supabase OAuth redirect):
                 hu.vedettsarok.utvonal://auth/callback — pontos séma/host/útvonal. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="hu.vedettsarok.utvonal"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>

        </activity>

        <!-- Védett Útvonal háttérnavigációs MVP: csak a látható appból, a
             felhasználó navigációindítására induló, "location" típusú
             foreground service (leszállási figyelmeztetés). -->
        <service
            android:name=".navigation.NavigationLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vedett Utvonal v0.1 — ELOTERI (foreground-only) helymeghatarozas
         a navigacios/"Aktualis helyzetem" funkciohoz, a @capacitor/geolocation
         pluginon keresztul (lib/hooks/useGeolocation.ts webes megfeleloje).
         SZANDEKOSAN NINCS ACCESS_BACKGROUND_LOCATION, nincs always-on/
         background tracking — csak amig az app a kepernyon van. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Háttérnavigációs MVP: látható appból indított location foreground
         service + értesítések. ACCESS_BACKGROUND_LOCATION továbbra sincs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
