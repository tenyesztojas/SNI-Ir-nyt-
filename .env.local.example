# Másold .env.local néven, és töltsd ki a Supabase projekt adataival
# (Supabase Dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Védett Útvonal (admin-only fejlesztési modul, lásd docs/vedett-route.md)
BKK_API_KEY=
VEDETT_ROUTE_ENABLED=
MOTIS_BASE_URL=
